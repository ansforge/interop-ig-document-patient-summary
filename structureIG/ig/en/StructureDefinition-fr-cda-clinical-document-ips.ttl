         fhir:Extension.valueUri [ fhir:value "urn:hl7-org:sdtc" ]
       ], [
         fhir:index -1 ;
         fhir:Extension.url [ fhir:value "http://hl7.org/fhir/tools/StructureDefinition/xml-name" ] ;
         fhir:Extension.valueString [ fhir:value "statusCode" ]
       ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.sdtcStatusCode" ] ;
       fhir:ElementDefinition.definition [ fhir:value "The statusCode extension attribute allows the implementer to identify a ClinicalDocument that is in other than the completed state. It was created to support the Structured Form Definition IG to identify that the document itself is an unfinished product currently being completed for a patient." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.sdtcStatusCode" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/CS" ]
       ] ;
       fhir:ElementDefinition.binding [
         fhir:ElementDefinition.binding.strength [ fhir:value "required" ] ;
         fhir:ElementDefinition.binding.valueSet [
           fhir:value "http://terminology.hl7.org/ValueSet/v3-ActStatus|3.0.0" ;
           fhir:link <http://terminology.hl7.org/ValueSet/v3-ActStatus|3.0.0>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.effectiveTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.effectiveTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "Date de création du document Synthèse Médicale." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Signifies the document creation time, when the document first came into being." ] ;
       fhir:ElementDefinition.comment [ fhir:value "Where the CDA document is a transform from an original document in some other format, the ClinicalDocument.effectiveTime is the time the original document is created. The time when the transform occurred is not currently represented in CDA." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
