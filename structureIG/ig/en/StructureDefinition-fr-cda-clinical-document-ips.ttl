     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.documentationOf" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.documentationOf" ] ;
       fhir:ElementDefinition.short [ fhir:value "Evènement documenté et notamment le cadre d'exercice." ] ;
       fhir:ElementDefinition.comment [ fhir:value "In some cases, the ServiceEvent is inherent in the ClinicalDocument.code, such as where ClinicalDocument.code is 'History and Physical Report' and the procedure being documented is a 'History and Physical' act. A ServiceEvent can further specialize the act inherent in the ClinicalDocument.code, such as where the ClinicalDocument.code is simply 'Procedure Report' and the procedure was a 'colonoscopy'. If ServiceEvent is included, it must be equivalent to or further specialize the value inherent in the ClinicalDocument.code, and shall not conflict with the value inherent in the ClinicalDocument.code, as such a conflict would constitute an ambiguous situation." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.documentationOf" ] ;
