         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/TS" ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.recordTarget" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.recordTarget" ] ;
       fhir:ElementDefinition.short [ fhir:value "Patient/Usager concerné par le document." ] ;
       fhir:ElementDefinition.comment [ fhir:value "A clinical document typically has exactly one recordTarget participant. In the uncommon case where a clinical document (such as a group encounter note) is placed into more than one patient chart, more than one recordTarget participants can be stated." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "The recordTarget(s) of a document are stated in the header and propagate to nested content, where they cannot be overridden." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.recordTarget" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/RecordTarget" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-record-target|0.1.0" ;
           fhir:index -1 ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-record-target|0.1.0>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.author" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.author" ] ;
       fhir:ElementDefinition.short [ fhir:value "Professionnel ou patient/usager ou système, auteur du document incluant la structure de rattachement de l'auteur." ] ;
       fhir:ElementDefinition.comment [ fhir:value "In some cases, the role or function of the author is inherent in the ClinicalDocument.code, such as where ClinicalDocument.code is 'Medical Student Progress Note'. The role of the author can also be recorded in the Author.functionCode or AssignedAuthor.code attribute. If either of these attributes is included, they should be equivalent to or further specialize the role inherent in the ClinicalDocument.code (such as where the ClinicalDocument.code is simply 'Physician Progress Note' and the value of Author.functionCode is 'rounding physician'), and shall not conflict with the role inherent in the ClinicalDocument.code, as such a conflict would constitute an ambiguous situation." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.author" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/Author" ] ;
         fhir:ElementDefinition.type.profile [
