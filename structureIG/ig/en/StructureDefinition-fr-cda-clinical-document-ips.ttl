     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.copyTime" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.copyTime" ] ;
       fhir:ElementDefinition.short [ fhir:value "Deprecated - use is discouraged" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Represents the time a document is released (i.e. copied or sent to a display device) from a document management system that maintains revision control over the document. Once valued, it cannot be changed. The intent is to give the viewer of the document some notion as to how long the document has been out of the safe context of its document management system." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "Included for backwards compatibility with CDA, Release One. ClinicalDocument.copyTime has been deprecated because it is not part of the document at the time it is authenticated, but instead represents metadata about the document, applied at some variable time after authentication. Further use is discouraged." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "0" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.copyTime" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
