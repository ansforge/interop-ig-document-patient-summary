         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/Custodian" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-custodian|0.1.0" ;
           fhir:index -1 ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-custodian|0.1.0>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.informationRecipient" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.informationRecipient" ] ;
       fhir:ElementDefinition.short [ fhir:value "Destinataire prévu du document." ] ;
       fhir:ElementDefinition.comment [ fhir:value "The information recipient is an entity to whom a copy of a document is directed, at the time of document authorship. It is not the same as the cumulative set of persons to whom the document has subsequently been disclosed, over the life-time of the patient. Such a disclosure list would not be contained within the document, and it outside the scope of CDA." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.informationRecipient" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/InformationRecipient" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-information-recipient|0.1.0" ;
           fhir:index -1 ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-information-recipient|0.1.0>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.legalAuthenticator" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.legalAuthenticator" ] ;
       fhir:ElementDefinition.short [ fhir:value "Professionnel ou patient/usager ou système responsable du document." ] ;
       fhir:ElementDefinition.comment [ fhir:value "The CDA is a standard that specifies the structure of exchanged clinical documents. In the case where a local document is transformed into a CDA document for exchange, authentication occurs on the local document, and that fact is reflected in the exchanged CDA document. A CDA document can reflect the unauthenticated, authenticated, or legally authenticated state. The unauthenticated state exists when no authentication information has been recorded (i.e., it is the absence of being either authenticated or legally authenticated)." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "While electronic signatures are not captured in a CDA document, both authentication and legal authentication require that a document has been signed manually or electronically by the responsible individual. A legalAuthenticator has a required legalAuthenticator.time indicating the time of authentication, and a required legalAuthenticator.signatureCode, indicating that a signature has been obtained and is on file." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.legalAuthenticator" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/LegalAuthenticator" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-legal-authenticator|0.1.0" ;
           fhir:index -1 ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-legal-authenticator|0.1.0>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.authenticator" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.authenticator" ] ;
       fhir:ElementDefinition.short [ fhir:value "Professionnel attestant la validité du document" ] ;
       fhir:ElementDefinition.definition [ fhir:value "Represents a participant who has attested to the accuracy of the document, but who does not have privileges to legally authenticate the document. An example would be a resident physician who sees a patient and dictates a note, then later signs it." ] ;
       fhir:ElementDefinition.comment [ fhir:value "A clinical document can have zero to many authenticators. While electronic signatures are not captured in a CDA document, both authentication and legal authentication require that a document has been signed manually or electronically by the responsible individual. An authenticator has a required authenticator.time indicating the time of authentication, and a required authenticator.signatureCode, indicating that a signature has been obtained and is on file." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "*" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.authenticator" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/Authenticator" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-authenticator|0.1.0" ;
           fhir:index -1 ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-authenticator|0.1.0>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.participant" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.participant" ] ;
       fhir:ElementDefinition.slicing [
         fhir:ElementDefinition.slicing.discriminator [
           fhir:index -1 ;
           fhir:ElementDefinition.slicing.discriminator.type [ fhir:value "value" ] ;
           fhir:ElementDefinition.slicing.discriminator.path [ fhir:value "url" ]
         ] ;
         fhir:ElementDefinition.slicing.rules [ fhir:value "open" ]
       ] ;
       fhir:ElementDefinition.short [ fhir:value "Participant, différent de l'auteur, du responsable, de l'opérateur de saisie, de l'informateur ou du destinataire." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Used to represent other participants not explicitly mentioned by other classes, that were somehow involved in the documented acts." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
