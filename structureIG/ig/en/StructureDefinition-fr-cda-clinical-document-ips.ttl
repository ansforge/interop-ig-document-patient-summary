         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "*" ]
       ] ;
       fhir:ElementDefinition.type [
         fhir:index -1 ;
         fhir:ElementDefinition.type.code [ fhir:value "http://hl7.org/cda/stds/core/StructureDefinition/Informant" ] ;
         fhir:ElementDefinition.type.profile [
           fhir:value "https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-informant|0.1.0" ;
           fhir:index -1 ;
           fhir:link <https://interop.esante.gouv.fr/ig/cda/document-core/StructureDefinition/fr-cda-informant|0.1.0>
         ]
       ]
     ], [
       fhir:index -1 ;
       fhir:Element.id [ fhir:value "ClinicalDocument.custodian" ] ;
       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.custodian" ] ;
       fhir:ElementDefinition.short [ fhir:value "Structure conservant le document et garantissant son cycle de vie." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Represents the organization that is in charge of maintaining the document. The custodian is the steward that is entrusted with the care of the document. Every CDA document has exactly one custodian." ] ;
       fhir:ElementDefinition.requirements [ fhir:value "The custodian participation satisfies the CDA definition of Stewardship. Because CDA is an exchange standard and may not represent the original form of the authenticated document, the custodian represents the steward of the original source document." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.custodian" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
         fhir:ElementDefinition.base.max [ fhir:value "1" ]
       ] ;
