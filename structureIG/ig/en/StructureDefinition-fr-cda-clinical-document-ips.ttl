       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.confidentialityCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Niveau de confidentialité du document." ] ;
       fhir:ElementDefinition.comment [ fhir:value "Confidentiality is a required contextual component of CDA, where the value expressed in the header holds true for the entire document, unless overridden by a nested value." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
