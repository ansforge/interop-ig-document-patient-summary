       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.languageCode" ] ;
       fhir:ElementDefinition.short [ fhir:value "Langue principale du document." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Specifies the human language of character data (whether they be in contents or attribute values)." ] ;
       fhir:ElementDefinition.comment [ fhir:value "Language is a contextual component of CDA, where the value expressed in the header holds true for the entire document, unless overridden by a nested value." ] ;
       fhir:ElementDefinition.min [ fhir:value "1"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
         fhir:ElementDefinition.base.path [ fhir:value "ClinicalDocument.languageCode" ] ;
         fhir:ElementDefinition.base.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
