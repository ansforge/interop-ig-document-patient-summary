       fhir:ElementDefinition.path [ fhir:value "ClinicalDocument.participant" ] ;
       fhir:ElementDefinition.sliceName [ fhir:value "medecinTraitant" ] ;
       fhir:ElementDefinition.short [ fhir:value "Participant, différent de l'auteur, du responsable, de l'opérateur de saisie, de l'informateur ou du destinataire." ] ;
       fhir:ElementDefinition.definition [ fhir:value "Used to represent other participants not explicitly mentioned by other classes, that were somehow involved in the documented acts." ] ;
       fhir:ElementDefinition.min [ fhir:value "0"^^xsd:nonNegativeInteger ] ;
       fhir:ElementDefinition.max [ fhir:value "1" ] ;
       fhir:ElementDefinition.base [
